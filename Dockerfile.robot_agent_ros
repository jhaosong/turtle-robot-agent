ARG ROS_DISTRO=humble

# Keep the expensive Python dependency layer independent from the Gazebo
# overlay. Rebuilding a world or RViz package must not reinstall YOLOE/Torch.
FROM osrf/ros:${ROS_DISTRO}-desktop AS robot_agent_dependencies

USER root
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

COPY src/robot_agent/requirements.txt /tmp/robot-agent-requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m venv --system-site-packages /opt/robot-agent-venv && \
    /opt/robot-agent-venv/bin/python -m pip install --upgrade pip setuptools wheel && \
    /opt/robot-agent-venv/bin/python -m pip install -r /tmp/robot-agent-requirements.txt


FROM turtlebot3_behavior:overlay

USER root
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    PATH=/opt/robot-agent-venv/bin:${PATH}

RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

COPY --link --from=robot_agent_dependencies /opt/robot-agent-venv /opt/robot-agent-venv

# Symlink-install points ROS executables back into these source directories;
# archive transfers from macOS may not preserve their executable bits.
RUN chmod 0755 \
        /entrypoint.sh \
        /overlay_ws/src/tb3_worlds/scripts/*.py

WORKDIR /app
CMD ["/app/run_robot_agent_ros.sh"]
